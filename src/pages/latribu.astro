---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const latribuItems = (await getCollection('latribu'))
	.filter((entry) => !entry.slug.includes('/'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title="La Tribu 963 | Camilo Sandoval" description="Descubre más sobre La Tribu 963">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<header>
				<Hero
					title="La Tribu 963"
					tagline="Un espacio para historias, encuentros y aprendizajes en comunidad"
					align="start"
				/>
			</header>

			<div class="latribu-layout">
				<article class="latribu-row highlight-row">
					<div class="latribu-row-entry">
						<a class="trayectoria-card" href="/latribu/trayectoria/">
							<strong>Trayectoria</strong>
							<p>Ir a la lista de entradas de trayectoria de La Tribu 963.</p>
						</a>
					</div>
					<div class="latribu-row-summary">
						<div class="summary-card">
							<h2>Trayectoria</h2>
							<p>Accede a los eventos y capítulos que forman parte de nuestra historia.</p>
						</div>
					</div>
				</article>

				{
					latribuItems.map((project) => (
						<article class="latribu-row">
							<div class="latribu-row-entry">
								<PortfolioPreview project={project} />
							</div>
							<div class="latribu-row-summary">
								<div class="summary-card">
									<h2>{project.data.title}</h2>
									<p>{project.data.description}</p>
									{project.data.tags?.length ? (
										<div class="tags">
											{project.data.tags.map((tag: string) => <span>{tag}</span>)}
										</div>
									) : null}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</main>
		<div class="footer-divider"></div>
	</div>
</BaseLayout>

<style>
	.latribu-layout {
		display: grid;
		gap: 3rem;
	}

	.latribu-row {
		display: grid;
		grid-template-columns: minmax(0, 1.75fr) minmax(18rem, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.highlight-row {
		border: 1px solid rgba(255,255,255,0.08);
		border-radius: 1.5rem;
		padding: 1.5rem;
		background: rgba(255,255,255,0.03);
	}

	.trayectoria-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: var(--gradient-subtle);
		color: inherit;
		text-decoration: none;
	}

	.trayectoria-card strong {
		display: block;
		font-size: var(--text-2xl);
		margin-bottom: 0.75rem;
	}

	.trayectoria-card p {
		margin: 0;
		color: var(--gray-300);
		line-height: 1.7;
	}

	.latribu-row-entry {
		min-width: 0;
	}

	.latribu-row-summary {
		min-width: 0;
	}

	.summary-card {
		display: grid;
		gap: 1.5rem;
		padding: 2rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.summary-card h2 {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.summary-card p {
		margin: 0;
		line-height: 1.8;
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tags span {
		display: inline-flex;
		padding: 0.5rem 0.75rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		color: var(--gray-200);
		font-size: var(--text-sm);
	}

	.footer-divider {
		border-top: 1px solid var(--gray-800);
		margin-top: 4rem;
		width: 100%;
	}

	@media (max-width: 64em) {
		.latribu-row {
			grid-template-columns: 1fr;
		}
	}
</style>