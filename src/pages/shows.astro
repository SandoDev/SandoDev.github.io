---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ShowsPreview from '../components/ShowsPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const showItems = (await getCollection('shows')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Shows y Presentaciones | Camilo Sandoval"
	description="Mira algunos de mis shows y presentaciones"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Shows y Presentaciones"
				tagline="Mira algunos de mis shows y presentaciones"
				align="start"
			/>
			<Grid variant="offset">
				{
					showItems.map((item) => (
						<li>
							<ShowsPreview project={item} />
						</li>
					))
				}
			</Grid>
		</main>
	</div>
</BaseLayout>
