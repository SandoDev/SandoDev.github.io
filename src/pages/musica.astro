---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import MusicPreview from '../components/MusicPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const musicItems = (await getCollection('music')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Música | Camilo Sandoval"
	description="Descubre la música de Camilo Sandoval"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Música"
				tagline="Explora mis lanzamientos musicales"
				align="start"
			/>
			<Grid variant="offset">
				{
					musicItems.map((item) => (
						<li>
							<MusicPreview project={item} />
						</li>
					))
				}
			</Grid>
		</main>
		<div class="footer-divider"></div>
	</div>
</BaseLayout>

<style>
	.footer-divider {
		border-top: 1px solid var(--gray-800);
		margin-top: 4rem;
		width: 100%;
	}
</style>